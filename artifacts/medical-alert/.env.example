# Copy this file to .env when the backend is not on http://localhost:5000.
# Only EXPO_PUBLIC_* variables reach the app bundle, and they are inlined at
# build time — restart `expo start` after changing one. Never put a secret here.

# Origin of the backend, without a trailing slash and without /api.
# Leave unset locally: the app then guesses localhost (web / iOS simulator),
# 10.0.2.2 (Android emulator) or the packager's LAN address (real device).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
