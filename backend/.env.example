# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# OPTIONAL. Leave unset for the hackathon demo: the server then starts a
# temporary in-memory MongoDB automatically (data is wiped on every restart).
# Set it to a local MongoDB or a MongoDB Atlas connection string to persist data.
# MONGO_URI=mongodb://127.0.0.1:27017/medical_alert
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medical_alert

# --- Claude (Anthropic) ---
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=25000
# Server-side fallback: Anthropic re-runs a declined request on another model.
# Set to false if your organisation has not enabled the beta.
ANTHROPIC_ENABLE_FALLBACK=true

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- CORS: comma-separated origins, or * for any ---
ALLOWED_ORIGINS=*

# --- Optional outbound alert webhook (leave blank to disable) ---
# POST target that forwards the alert to the emergency contact (SMS gateway,
# on-call service, ...). The frontend's call button works without it.
EMERGENCY_WEBHOOK_URL=
